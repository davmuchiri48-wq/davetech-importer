# ---------- Server (secret — set on Render, never commit real values)
# Whole Firebase service-account JSON on one line (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
# Emails that become admins on first login (comma separated)
ADMIN_EMAILS=davmuchiri48@gmail.com
# 32+ random characters, used to encrypt the shop API key and AliExpress tokens. Never change it after setup.
ENCRYPTION_KEY=
# Address of this importer, e.g. https://davetech-importer.onrender.com (needed for AliExpress login callback)
PUBLIC_URL=
# AliExpress Open Platform app (leave empty until your app is approved)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_SHIP_TO=KE
ALIEXPRESS_TARGET_CURRENCY=USD

# ---------- Dashboard (public Firebase web config — Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
