rules_version = '2';
// Davetech Importer: the browser never reads or writes Firestore directly.
// All access goes through the server (Firebase Admin SDK), which checks the user's
// role and store membership on every request. Denying everything here means no
// store can ever read another store's data, and secrets/ can never leak.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
